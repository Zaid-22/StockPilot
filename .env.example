# Copy to .env and replace placeholders; never commit real values.
# SQL Server must be reachable from inside the container, not localhost.
STOCKPILOT_DB_CONNECTION=Server=YOUR_SQL_HOST,1433;Database=StockPilot;User Id=YOUR_RUNTIME_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false
STOCKPILOT_ALLOWED_HOSTS=localhost;127.0.0.1
STOCKPILOT_CERT_PATH=/absolute/path/to/stockpilot.pfx
STOCKPILOT_CERT_PASSWORD=YOUR_CERTIFICATE_PASSWORD
